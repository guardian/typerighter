#!/bin/bash -e

APP_FOLDER="apps"
ROOT_DIR="$APP_FOLDER/../"

checkNodeVersion() {
  runningNodeVersion=$(node -v)
  requiredNodeMajorVersion=$(cat "$ROOT_DIR/.nvmrc")

  # remove leading v
  runningNodeVersionNumber=${runningNodeVersion//[v]/}

  if [[ "$runningNodeVersionNumber" != $requiredNodeMajorVersion* ]]; then
    echo -e "❌ Using wrong version of Node. Required v${requiredNodeMajorVersion}. Running ${runningNodeVersion}."
    exit 1
  fi
}

checkNodeVersion
