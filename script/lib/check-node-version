#!/bin/bash -e

APP_FOLDER="apps"
ROOT_DIR="$APP_FOLDER/../"

checkNodeVersion() {
    NODE_MAJOR_VERSION=$(node -v | cut -d "." -f 1)
    DESIRED_NODE_VERSION=$(cat "$ROOT_DIR/.tool-versions" | sed -n 's/node //p')

    if [[ "v${DESIRED_NODE_VERSION}" != "${NODE_MAJOR_VERSION}"* ]]; then
        echo -e "❌ Using wrong version of Node. Required v${DESIRED_NODE_VERSION}. Running ${NODE_MAJOR_VERSION}."
        exit 1
        exit 1
    fi
}

checkNodeVersion
